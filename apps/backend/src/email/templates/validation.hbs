<!-- src/email/templates/validation.hbs -->
<!doctype html>
<html lang="{{lang}}" dir="{{dir}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{title}} – {{appName}}</title>
    <style>
      body { margin:0; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif; background:#f6f7fb; }
      .container { max-width: 560px; margin: 24px auto; background:#ffffff; border-radius: 12px; padding: 24px; }
      h1 { margin: 0 0 12px; font-size: 20px; }
      p  { margin: 0 0 12px; line-height: 1.5; }
      .code-wrap { margin: 20px 0; text-align: center; }
      .code {
        display: inline-block; font-size: 28px; letter-spacing: 6px; font-weight: 700;
        padding: 12px 18px; border: 1px dashed #d8dbe2; border-radius: 10px; background:#f9fafb;
      }
      .meta { color:#6b7280; font-size: 12px; margin-top: 16px; }
      .footer { color:#9aa0a6; font-size: 12px; text-align: center; margin-top: 24px; }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>{{title}}</h1>
      <p>{{greeting}}</p>
      <p>{{intro}}</p>

      <div class="code-wrap">
        <div class="code" aria-label="{{codeLabel}}">{{code}}</div>
      </div>

      <p class="meta">{{expiresIn}}</p>
      <p class="footer">{{footer}}</p>
    </div>
  </body>
</html>
