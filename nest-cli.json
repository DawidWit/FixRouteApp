{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "monorepo": true,
  "root": ".",
  "sourceRoot": "apps/backend/src",
  "projects": {
    "backend": {
      "type": "application",
      "root": "apps/backend",
      "entryFile": "main",
      "sourceRoot": "apps/backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/backend/tsconfig.app.json"
      }
    },
    "shared_types": {
      "type": "library",
      "root": "apps/shared_types",
      "entryFile": "index",
      "sourceRoot": "apps/shared_types/src"
    }
  }
}